{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "wrench-billing-api"
  },
  "JwtOptions": {
    "Issuer": "Wrench Auto Repair",
    "Audience": "Wrench Auto Repair"
  },
  "ConnectionStrings": {
    "Billing": ""
  },
  "Database": {
    "UseInMemory": false,
    "MigrateOnStartup": false
  },
  "Messaging": {
    "Transport": "Sqs",
    "Region": "us-east-1",
    "ServiceUrl": "",
    "TopicoEventos": "wrench-billing-events",
    "TopicoComandos": "wrench-os-events",
    "PrefixoFilas": "billing"
  },
  "Pagamento": {
    "ExpiracaoPixMinutos": 30,
    "WebhookSecret": "",
    "ReconciliacaoIntervaloSegundos": 30,
    "ReconciliacaoHabilitada": true,
    "Mock": {
      "FalharEstorno": false
    }
  },
  "Simulacao": {
    "Habilitada": false,
    "WebhookBaseUrl": "http://localhost:8080"
  }
}